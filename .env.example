# ============================================================
# Mistral AI Search Visibility Study — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ------------------------------------------------------------
# LLM API Keys (Required)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# GCP Configuration (Required)
# ------------------------------------------------------------
GCP_PROJECT_ID=project-553727f2-fa51-4dd8-8e0
GCP_REGION=US
GCS_BUCKET_NAME=mistral-visibility-raw-responses
BQ_DATASET=mistral_visibility

# Path to your GCP service account JSON key file
# Download from: GCP Console → IAM → Service Accounts → Keys
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-key.json

# ------------------------------------------------------------
# LLM Model Selection (Optional — defaults shown)
# ------------------------------------------------------------
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------
# Phase 2 RAG Settings (Optional — defaults shown)
# ------------------------------------------------------------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ------------------------------------------------------------
# Scheduler (Optional — defaults shown)
# ------------------------------------------------------------
# Cron format: minute hour day_of_month month day_of_week
# Default: every Monday at 09:00 UTC
SCHEDULE_CRON=0 9 * * 1

# ------------------------------------------------------------
# Misc (Optional)
# ------------------------------------------------------------
LOG_LEVEL=INFO
RUN_ID_PREFIX=visibility
