# ============================================================
# AI Search Visibility Study — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
#
# To study a different brand, only change the BRAND section.
# Everything else is infrastructure config.

# ------------------------------------------------------------
# BRAND CONFIGURATION  ← only section you need to change
# ------------------------------------------------------------

# The brand/product you want to measure visibility for
BRAND_NAME=Mistral AI

# Lowercase slug used in regex matching (no spaces)
BRAND_SLUG=mistral

# Comma-separated aliases/variations the brand is known by
BRAND_ALIASES=mistral,mixtral,mistral ai

# One sentence describing the product (used in content generation)
BRAND_DESCRIPTION=a French AI company offering open and closed-weight large language models

# The product/market category (used to generate query templates)
# Examples: "large language model provider", "cloud database", "API monitoring tool",
#           "developer productivity tool", "vector database"
BRAND_CATEGORY=large language model provider

# Comma-separated competitor names to track for Share of Voice
COMPETITOR_NAMES=openai,gpt-4,gpt4,chatgpt,claude,anthropic,gemini,google,llama,meta,cohere,falcon

# ------------------------------------------------------------
# LLM API Keys (Required)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to true to include Gemini in queries (rate limits apply on free tier)
ENABLE_GEMINI=false

# ------------------------------------------------------------
# GCP Configuration (Required for full data persistence)
# If not set, dashboard runs in demo mode from demo_data.json
# ------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=US
GCS_BUCKET_NAME=ai-visibility-raw-responses
BQ_DATASET=ai_visibility

# Path to GCP service account key, OR use:
#   gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-key.json

# ------------------------------------------------------------
# LLM Model Selection (Optional — defaults shown)
# ------------------------------------------------------------
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------
# Phase 2 RAG Settings (Optional — defaults shown)
# ------------------------------------------------------------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ------------------------------------------------------------
# Scheduler (Optional — defaults shown)
# ------------------------------------------------------------
# Cron format: minute hour day_of_month month day_of_week
# Default: every Monday at 09:00 UTC
SCHEDULE_CRON=0 9 * * 1

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
LOG_LEVEL=INFO
RUN_ID_PREFIX=visibility
